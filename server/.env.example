# Copy to .env and fill in values (never commit .env)

# --- Database ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# --- Server ---
PORT=8000
NODE_ENV=development

# --- Auth (required for signup/login) ---
JWT_ACCESS_SECRET="generate-a-long-random-string"
# Optional; default 15m
# JWT_ACCESS_EXPIRES_IN=15m

# Comma-separated browser origins allowed to call the API (set your Vercel URL in production)
# Example: https://my-app.vercel.app,https://www.mydomain.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public URL of the Next.js app (used to redirect after Google OAuth). No trailing slash.
# Example: https://my-app.vercel.app
APP_CLIENT_URL=http://localhost:3000

# Stricter cap on email/password attempts per IP (per 15 minutes)
# AUTH_RATE_LIMIT_MAX=25

# --- Google OAuth (optional) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Redirect URI must match Google Cloud console (e.g. https://your-api.onrender.com/api/auth/google/callback)
# GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

# --- AI / SMTP / OCR ---
# GROQ_API_KEY=
# OPENAI_API_KEY=

# Semantic Ask AI runs the embedding model on the backend. Apply the pgvector migrations.

# Invoice email via Nodemailer + SMTP (Gmail: use an App Password, not your normal password)
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# Or aliases: GMAIL_USER / GMAIL_APP_PASSWORD
# SMTP_FROM="Accounting <you@gmail.com>"
# Optional overrides (defaults: smtp.gmail.com, port 465)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true

# OCR_SERVICE_URL=http://localhost:5001

# --- Optional one-time bootstrap (empty DB only; see prisma/seed.js) ---
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=change-me-now
