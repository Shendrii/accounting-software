// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id               String            @id @default(cuid())
  workspaceId      String
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  code             String
  name             String
  type             AccountType
  balance          Decimal           @default(0) @db.Decimal(15, 2)
  description      String?
  isActive         Boolean           @default(true)
  isBankAccount    Boolean           @default(false)
  role             AccountRole       @default(GENERAL)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  journalLines     JournalLine[]
  invoiceLines     InvoiceLine[]
  billLines        BillLine[]
  bankTransactions BankTransaction[]
  reconciliations  Reconciliation[]

  @@unique([workspaceId, code])
}

model JournalEntry {
  id                 String        @id @default(cuid())
  workspaceId        String
  workspace          Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  date               DateTime
  description        String
  referenceNo        String?
  status             Status        @default(DRAFT)
  isRecurring        Boolean       @default(false)
  recurrenceInterval String?
  nextDueDate        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  journalLines       JournalLine[]
  receipt            Receipt?
  invoices           Invoice[]
  bills              Bill[]
  billPosting        Bill?         @relation("BillPosting")
  billPayment        BillPayment?
  invoicePosting     Invoice?      @relation("InvoicePosting")
  invoicePayment     InvoicePayment?
  reversalOfId       String?       @unique
  reversalOf         JournalEntry? @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal           JournalEntry? @relation("JournalReversal")
  openingBatchId     String?
  openingBatch       OpeningBalanceBatch? @relation(fields: [openingBatchId], references: [id], onDelete: Restrict)
  invoicePaymentReversal InvoicePayment? @relation("InvoicePaymentReversal")
  billPaymentReversal BillPayment? @relation("BillPaymentReversal")

  @@index([workspaceId, status, date])
}

model Receipt {
  id             String        @id @default(cuid())
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  imageUrl       String
  imageHash      String?
  extractedData  Json
  status         ReceiptStatus @default(PENDING)
  journalEntryId String?       @unique
  vendorId       String?
  category       String?
  billId         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  vendor         Vendor?       @relation(fields: [vendorId], references: [id])
  bill           Bill?         @relation(fields: [billId], references: [id])
  image          ReceiptImage?

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, createdAt])
  @@index([billId])
  @@unique([workspaceId, imageHash])
}

model ReceiptImage {
  receiptId String  @id
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  jpeg      Bytes
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Decimal      @default(0) @db.Decimal(15, 2)
  credit         Decimal      @default(0) @db.Decimal(15, 2)
  description    String?
  createdAt      DateTime     @default(now())
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId, journalEntryId])
}

model Customer {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  address     String?
  city        String?
  country     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  invoices    Invoice[]
}

model Vendor {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  address     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bills       Bill[]
  receipts    Receipt[]
}

model Invoice {
  id             String        @id @default(cuid())
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoiceNo      String
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  date           DateTime
  dueDate        DateTime
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @db.Decimal(15, 2)
  tax            Decimal       @default(0) @db.Decimal(15, 2)
  total          Decimal       @db.Decimal(15, 2)
  notes          String?
  journalEntryId String?       @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  postingEntryId String?       @unique
  postingEntry   JournalEntry? @relation("InvoicePosting", fields: [postingEntryId], references: [id], onDelete: Restrict)
  emailSentAt    DateTime?
  isOpeningBalance Boolean      @default(false)
  payments       InvoicePayment[]
  lines          InvoiceLine[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([workspaceId, invoiceNo])
  @@index([workspaceId, date, id])
  @@index([workspaceId, status, dueDate])
}

model InvoicePayment {
  id             String       @id @default(cuid())
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  journalEntryId String       @unique
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  requestId      String
  amount         Decimal      @db.Decimal(15, 2)
  reversalEntryId String?      @unique
  reversalEntry  JournalEntry? @relation("InvoicePaymentReversal", fields: [reversalEntryId], references: [id], onDelete: Restrict)
  reversalRequestId String?
  reversalReason String?
  reversedById   String?
  reversedAt     DateTime?

  @@unique([invoiceId, requestId])
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @db.Decimal(15, 4)
  unitPrice   Decimal  @db.Decimal(15, 2)
  amount      Decimal  @db.Decimal(15, 2)
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id])
}

model Bill {
  id                 String        @id @default(cuid())
  workspaceId        String
  workspace          Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  billNo             String
  vendorInvoiceNo    String?
  vendorId           String
  vendor             Vendor        @relation(fields: [vendorId], references: [id])
  date               DateTime
  dueDate            DateTime
  status             BillStatus    @default(DRAFT)
  total              Decimal       @db.Decimal(15, 2)
  notes              String?
  isRecurring        Boolean       @default(false)
  recurrenceInterval String?
  nextDueDate        DateTime?
  journalEntryId     String?       @unique
  journalEntry       JournalEntry? @relation(fields: [journalEntryId], references: [id])
  postingEntryId     String?       @unique
  isOpeningBalance   Boolean       @default(false)
  postingEntry       JournalEntry? @relation("BillPosting", fields: [postingEntryId], references: [id], onDelete: Restrict)
  payments           BillPayment[]
  lines              BillLine[]
  receipts           Receipt[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([workspaceId, billNo])
  @@unique([workspaceId, vendorId, vendorInvoiceNo])
  @@index([workspaceId, date, id])
  @@index([workspaceId, status, dueDate])
}

model BillPayment {
  id             String       @id @default(cuid())
  billId         String
  bill           Bill         @relation(fields: [billId], references: [id], onDelete: Restrict)
  journalEntryId String       @unique
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  requestId      String
  amount         Decimal      @db.Decimal(15, 2)
  reversalEntryId String?      @unique
  reversalEntry  JournalEntry? @relation("BillPaymentReversal", fields: [reversalEntryId], references: [id], onDelete: Restrict)
  reversalRequestId String?
  reversalReason String?
  reversedById   String?
  reversedAt     DateTime?

  @@unique([billId, requestId])
}

model BillLine {
  id          String   @id @default(cuid())
  billId      String
  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @db.Decimal(15, 4)
  unitPrice   Decimal  @db.Decimal(15, 2)
  amount      Decimal  @db.Decimal(15, 2)
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id])
}

model BankTransaction {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId     String
  account       Account   @relation(fields: [accountId], references: [id])
  date          DateTime
  description   String
  amount        Decimal   @db.Decimal(15, 2)
  isMatched     Boolean   @default(false)
  matchedLineId String?   @unique
  reconciliationId String?
  reconciliation Reconciliation? @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now())

  @@index([workspaceId, accountId, date])
  @@index([reconciliationId])
}

model Reconciliation {
  id               String    @id @default(cuid())
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId        String
  account          Account   @relation(fields: [accountId], references: [id])
  statementDate    DateTime
  statementBalance Decimal   @db.Decimal(15, 2)
  status           String    @default("IN_PROGRESS")
  proof            Json?
  bankTransactions BankTransaction[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([workspaceId, accountId, statementDate])
}

enum ReceiptStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountRole {
  GENERAL
  CASH
  BANK
  ACCOUNTS_RECEIVABLE
  ACCOUNTS_PAYABLE
  CREDIT_CARD
  SALES_TAX
}

enum Status {
  DRAFT
  POSTED
  ARCHIVED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

enum BillStatus {
  DRAFT
  RECEIVED
  PAID
  VOID
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String?
  name             String
  avatarUrl        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  providers        AuthProvider[]
  invitesSent      WorkspaceInvite[] @relation("InviteSender")
}

model Workspace {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  type             WorkspaceType     @default(PERSONAL)
  ownerUserId      String
  country          String?           @db.VarChar(2)
  currency         String            @default("USD") @db.VarChar(3)
  legalName        String?
  entityType       String?
  region           String?
  fiscalYearStartMonth Int           @default(1)
  booksStartDate   DateTime?         @db.Date
  accountingBasis String            @default("ACCRUAL")
  taxSettings      Json?
  setupCompletedAt DateTime?
  ownerUser        User              @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  members          WorkspaceMember[]
  invites          WorkspaceInvite[]
  accounts         Account[]
  journalEntries   JournalEntry[]
  receipts         Receipt[]
  customers        Customer[]
  vendors          Vendor[]
  invoices         Invoice[]
  bills            Bill[]
  bankTransactions BankTransaction[]
  reconciliations  Reconciliation[]
  openingBalance   OpeningBalanceBatch?
}

model OpeningBalanceBatch {
  id          String      @id @default(cuid())
  workspaceId String      @unique
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  requestId   String
  fingerprint String
  asOfDate    DateTime    @db.Date
  currency    String      @db.VarChar(3)
  createdById String
  snapshot    Json
  createdAt   DateTime    @default(now())
  entries     JournalEntry[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, createdAt])
}

model AuthProvider {
  id                String           @id @default(cuid())
  userId            String
  provider          AuthProviderType
  providerAccountId String
  createdAt         DateTime         @default(now())
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model WorkspaceInvite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String?
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User?         @relation("InviteSender", fields: [invitedById], references: [id])
}

enum WorkspaceType {
  PERSONAL
  TEAM
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum AuthProviderType {
  LOCAL
  GOOGLE
}
