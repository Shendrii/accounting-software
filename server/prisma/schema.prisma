// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id               String            @id @default(cuid())
  workspaceId      String
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  code             String
  name             String
  type             AccountType
  balance          Decimal           @default(0) @db.Decimal(15, 2)
  description      String?
  isActive         Boolean           @default(true)
  isBankAccount    Boolean           @default(false)
  role             AccountRole       @default(GENERAL)
  reportingGroup String?
  cashFlowCategory String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  journalLines     JournalLine[]
  invoiceLines     InvoiceLine[]
  billLines        BillLine[]
  bankTransactions BankTransaction[]
  reconciliations  Reconciliation[]

  @@unique([workspaceId, code])
}

model JournalEntry {
  scheduleOccurrence ScheduleOccurrence? @relation("SchedulePosting")
  scheduleReversalOccurrence ScheduleOccurrence? @relation("ScheduleReversal")
  id                 String        @id @default(cuid())
  workspaceId        String
  workspace          Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  date               DateTime
  description        String
  referenceNo        String?
  createdById        String?
  lastPreparedById   String?
  lastPreparedAt     DateTime?
  postedById         String?
  postedAt           DateTime?
  controlOverrideReason String?
  status             Status        @default(DRAFT)
  isRecurring        Boolean       @default(false)
  recurrenceInterval String?
  recurrenceAnchorDay Int?
  nextDueDate        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  journalLines       JournalLine[]
  receipt            Receipt?
  receiptCorrection  ReceiptCorrection?
  invoices           Invoice[]
  bills              Bill[]
  billPosting        Bill?         @relation("BillPosting")
  billPayment        BillPayment?
  invoicePosting     Invoice?      @relation("InvoicePosting")
  invoicePayment     InvoicePayment?
  reversalOfId       String?       @unique
  reversalOf         JournalEntry? @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal           JournalEntry? @relation("JournalReversal")
  openingBatchId     String?
  openingBatch       OpeningBalanceBatch? @relation(fields: [openingBatchId], references: [id], onDelete: Restrict)
  invoicePaymentReversal InvoicePayment? @relation("InvoicePaymentReversal")
  billPaymentReversal BillPayment? @relation("BillPaymentReversal")

  @@index([workspaceId, status, date])
}

model Receipt {
  id             String        @id @default(cuid())
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  imageUrl       String
  imageHash      String?
  postingDate    DateTime? @db.Date
  extractedData  Json
  status         ReceiptStatus @default(PENDING)
  journalEntryId String?       @unique
  vendorId       String?
  category       String?
  billId         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  vendor         Vendor?       @relation(fields: [vendorId], references: [id])
  bill           Bill?         @relation(fields: [billId], references: [id])
  image          ReceiptImage?
  correction     ReceiptCorrection?
  replacesReceiptId String? @unique
  replacesReceipt Receipt? @relation("ReceiptReplacement", fields: [replacesReceiptId], references: [id], onDelete: Restrict)
  replacement Receipt? @relation("ReceiptReplacement")

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, createdAt])
  @@index([billId])
  @@unique([workspaceId, imageHash])
}

model ReceiptCorrection {
  receiptId String @id
  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  requestId String
  kind String
  date DateTime @db.Date
  reason String
  createdById String
  createReplacement Boolean
  reversalEntryId String? @unique
  reversalEntry JournalEntry? @relation(fields: [reversalEntryId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
}

model ReceiptImage {
  receiptId String  @id
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  jpeg      Bytes
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Decimal      @default(0) @db.Decimal(15, 2)
  credit         Decimal      @default(0) @db.Decimal(15, 2)
  description    String?
  createdAt      DateTime     @default(now())
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  bankGroupLine BankMatchLine?
  account        Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId, journalEntryId])
}

model Customer {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  address     String?
  city        String?
  country     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  invoices    Invoice[]
  taxProfile Json?
}

model Vendor {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  address     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bills       Bill[]
  receipts    Receipt[]
  taxProfile Json?
}

model Invoice {
  id             String        @id @default(cuid())
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoiceNo      String
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  date           DateTime
  dueDate        DateTime
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @db.Decimal(15, 2)
  tax            Decimal       @default(0) @db.Decimal(15, 2)
  total          Decimal       @db.Decimal(15, 2)
  notes          String?
  taxCodeId      String?
  invoiceDetails Json?
  legalSnapshot Json?
  journalEntryId String?       @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  postingEntryId String?       @unique
  postingEntry   JournalEntry? @relation("InvoicePosting", fields: [postingEntryId], references: [id], onDelete: Restrict)
  emailSentAt    DateTime?
  isOpeningBalance Boolean      @default(false)
  payments       InvoicePayment[]
  creditAllocations CreditAllocation[]
  lines          InvoiceLine[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([workspaceId, invoiceNo])
  @@index([workspaceId, date, id])
  @@index([workspaceId, status, dueDate])
}

model InvoicePayment {
  id             String       @id @default(cuid())
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  journalEntryId String       @unique
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  requestId      String
  amount         Decimal      @db.Decimal(15, 2)
  reversalEntryId String?      @unique
  reversalEntry  JournalEntry? @relation("InvoicePaymentReversal", fields: [reversalEntryId], references: [id], onDelete: Restrict)
  reversalRequestId String?
  reversalReason String?
  reversedById   String?
  reversedAt     DateTime?

  @@unique([invoiceId, requestId])
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @db.Decimal(15, 4)
  unitPrice   Decimal  @db.Decimal(15, 2)
  amount      Decimal  @db.Decimal(15, 2)
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id])
}

model Bill {
  id                 String        @id @default(cuid())
  workspaceId        String
  workspace          Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  billNo             String
  vendorInvoiceNo    String?
  vendorId           String
  vendor             Vendor        @relation(fields: [vendorId], references: [id])
  date               DateTime
  dueDate            DateTime
  status             BillStatus    @default(DRAFT)
  total              Decimal       @db.Decimal(15, 2)
  tax                Decimal       @default(0) @db.Decimal(15,2)
  taxCodeId          String?
  notes              String?
  isRecurring        Boolean       @default(false)
  recurrenceInterval String?
  recurrenceAnchorDay Int?
  nextDueDate        DateTime?
  journalEntryId     String?       @unique
  journalEntry       JournalEntry? @relation(fields: [journalEntryId], references: [id])
  postingEntryId     String?       @unique
  isOpeningBalance   Boolean       @default(false)
  postingEntry       JournalEntry? @relation("BillPosting", fields: [postingEntryId], references: [id], onDelete: Restrict)
  payments           BillPayment[]
  creditAllocations CreditAllocation[]
  lines              BillLine[]
  receipts           Receipt[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([workspaceId, billNo])
  @@unique([workspaceId, vendorId, vendorInvoiceNo])
  @@index([workspaceId, date, id])
  @@index([workspaceId, status, dueDate])
}

model BillPayment {
  id             String       @id @default(cuid())
  billId         String
  bill           Bill         @relation(fields: [billId], references: [id], onDelete: Restrict)
  journalEntryId String       @unique
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  requestId      String
  amount         Decimal      @db.Decimal(15, 2)
  reversalEntryId String?      @unique
  reversalEntry  JournalEntry? @relation("BillPaymentReversal", fields: [reversalEntryId], references: [id], onDelete: Restrict)
  reversalRequestId String?
  reversalReason String?
  reversedById   String?
  reversedAt     DateTime?

  @@unique([billId, requestId])
}

model BillLine {
  id          String   @id @default(cuid())
  billId      String
  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @db.Decimal(15, 4)
  unitPrice   Decimal  @db.Decimal(15, 2)
  amount      Decimal  @db.Decimal(15, 2)
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id])
}

model BankTransaction {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId     String
  account       Account   @relation(fields: [accountId], references: [id])
  date          DateTime
  description   String
  amount        Decimal   @db.Decimal(15, 2)
  isMatched     Boolean   @default(false)
  matchedLineId String?   @unique
  reconciliationId String?
  reconciliation Reconciliation? @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now())
  groupMatch BankMatchRow?
  importId String?
  sourceRow Int?
  externalId String?
  @@unique([accountId,externalId])
  @@index([importId])

  @@index([workspaceId, accountId, date])
  @@index([reconciliationId])
}

model Reconciliation {
  id               String    @id @default(cuid())
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId        String
  account          Account   @relation(fields: [accountId], references: [id])
  statementDate    DateTime
  statementBalance Decimal   @db.Decimal(15, 2)
  status           String    @default("IN_PROGRESS")
  proof            Json?
  bankTransactions BankTransaction[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([workspaceId, accountId, statementDate])
}

enum ReceiptStatus {
  PENDING
  APPROVED
  REJECTED
  REVERSED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountRole {
  GENERAL
  CASH
  BANK
  ACCOUNTS_RECEIVABLE
  ACCOUNTS_PAYABLE
  CREDIT_CARD
  SALES_TAX
}

enum Status {
  DRAFT
  POSTED
  ARCHIVED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

enum BillStatus {
  DRAFT
  RECEIVED
  PAID
  VOID
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String?
  name             String
  avatarUrl        String?
  emailVerifiedAt  DateTime?
  sessionVersion   Int               @default(0)
  sessions         AuthSession[]
  authActions      AuthAction[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  providers        AuthProvider[]
  invitesSent      WorkspaceInvite[] @relation("InviteSender")
}

model AuthSession {
  id        String @id
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  version   Int
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model AuthAction {
  id        String @id @default(cuid())
  purpose   String
  tokenHash String @unique
  userId    String?
  user      User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  payload   Json?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, purpose])
}

model Workspace {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  type             WorkspaceType     @default(PERSONAL)
  ownerUserId      String
  country          String?           @db.VarChar(2)
  currency         String            @default("USD") @db.VarChar(3)
  legalName        String?
  entityType       String?
  region           String?
  fiscalYearStartMonth Int           @default(1)
  booksStartDate   DateTime?         @db.Date
  accountingBasis String            @default("ACCRUAL")
  taxSettings      Json?
  setupCompletedAt DateTime?
  separateCloseReviewer Boolean @default(false)
  memberCanPost    Boolean @default(false)
  requireJournalApproval Boolean @default(false)
  periods          AccountingPeriod[]
  auditEvents      AuditEvent[]
  recurringRuns    RecurringRun[]
  recurringOccurrences RecurringOccurrence[]
  ownerUser        User              @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  members          WorkspaceMember[]
  invites          WorkspaceInvite[]
  accounts         Account[]
  journalEntries   JournalEntry[]
  receipts         Receipt[]
  customers        Customer[]
  vendors          Vendor[]
  invoices         Invoice[]
  bills            Bill[]
  bankTransactions BankTransaction[]
  reconciliations  Reconciliation[]
  openingBalance   OpeningBalanceBatch?
  credits          CreditBalance[]
  financeActions   FinanceAction[]
  bankMatchGroups BankMatchGroup[]
  bankImports BankImport[]
  invoiceSettings Json?
  taxCodes TaxCode[]
  taxRecords TaxRecord[]
  cashFlowReviews CashFlowReview[]
  collectionActivities CollectionActivity[]
  accountingSchedules AccountingSchedule[]
}

model CollectionActivity {
 id String @id @default(cuid())
 workspaceId String
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Restrict)
 kind String
 partyId String
 documentId String?
 type String
 note String
 promiseDate DateTime? @db.Date
 promiseAmount Decimal? @db.Decimal(15,2)
 status String @default("OPEN")
 outcome String?
 createdById String
 createdAt DateTime @default(now())
 resolvedById String?
 resolvedAt DateTime?
 @@index([workspaceId,kind,partyId,createdAt])
 @@index([workspaceId,status,promiseDate])
}
model AccountingSchedule {
 id String @id @default(cuid())
 workspaceId String
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Restrict)
 type String
 name String
 reference String
 support String
 startDate DateTime @db.Date
 periods Int
 anchorDay Int?
 amount Decimal @db.Decimal(15,2)
 residual Decimal @default(0) @db.Decimal(15,2)
 debitAccountId String
 creditAccountId String
 sourceEntryId String?
 sourceAssetId String?
 reversalPolicy String @default("NONE")
 noReversalReason String?
 status String @default("ACTIVE")
 pausedFrom DateTime? @db.Date
 stateReason String?
 createdById String
 createdAt DateTime @default(now())
 occurrences ScheduleOccurrence[]
 @@unique([workspaceId,reference])
 @@index([workspaceId,sourceEntryId,sourceAssetId])
}
model ScheduleOccurrence {
 id String @id @default(cuid())
 scheduleId String
 schedule AccountingSchedule @relation(fields:[scheduleId],references:[id],onDelete:Restrict)
 index Int
 date DateTime @db.Date
 amount Decimal @db.Decimal(15,2)
 waivedReason String?
 archivedForPause Boolean @default(false)
 journalEntryId String @unique
 journalEntry JournalEntry @relation("SchedulePosting",fields:[journalEntryId],references:[id],onDelete:Restrict)
 reversalEntryId String? @unique
 reversalEntry JournalEntry? @relation("ScheduleReversal",fields:[reversalEntryId],references:[id],onDelete:Restrict)
 @@unique([scheduleId,index])
}

model CashFlowReview {
 id String @id @default(cuid())
 workspaceId String
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Restrict)
 journalEntryId String
 allocations Json
 reason String
 reviewedById String
 reviewedAt DateTime @default(now())
 @@unique([workspaceId,journalEntryId])
}

model TaxCode {
 id String @id @default(cuid())
 workspaceId String
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Restrict)
 code String
 label String
 purpose String
 accountId String?
 rate Decimal? @db.Decimal(9,6)
 effectiveFrom DateTime @db.Date
 effectiveTo DateTime? @db.Date
 registration String?
 isActive Boolean @default(true)
 createdAt DateTime @default(now())
 @@unique([workspaceId,code])
}
model TaxRecord {
 id String @id @default(cuid())
 workspaceId String
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Restrict)
 source String
 sourceId String
 postingEntryId String
 codeId String?
 codeSnapshot Json
 date DateTime @db.Date
 baseAmount Decimal @db.Decimal(15,2)
 amount Decimal @db.Decimal(15,2)
 evidenceStatus String @default("NOT_REQUIRED")
 evidenceReference String?
 @@index([workspaceId,date])
 @@unique([workspaceId,source,sourceId])
}

model BankMatchGroup {
 id String @id @default(cuid())
 workspaceId String
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Restrict)
 accountId String
 reason String
 createdById String
 createdAt DateTime @default(now())
 lines BankMatchLine[]
 rows BankMatchRow[]
 @@index([workspaceId,accountId])
}
model BankMatchLine {
 id String @id @default(cuid())
 groupId String
 group BankMatchGroup @relation(fields:[groupId],references:[id],onDelete:Cascade)
 journalLineId String @unique
 journalLine JournalLine @relation(fields:[journalLineId],references:[id],onDelete:Restrict)
}
model BankMatchRow {
 id String @id @default(cuid())
 groupId String
 group BankMatchGroup @relation(fields:[groupId],references:[id],onDelete:Cascade)
 bankTransactionId String @unique
 bankTransaction BankTransaction @relation(fields:[bankTransactionId],references:[id],onDelete:Restrict)
}
model BankImport {
 id String @id @default(cuid())
 workspaceId String
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Restrict)
 accountId String
 identity String
 fileName String
 dateFormat String
 rows Int
 imported Int
 duplicateChoice String
 createdById String
 createdAt DateTime @default(now())
 @@unique([workspaceId,accountId,identity])
}

model CreditBalance {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Restrict)
  kind String
  source String
  partyId String?
  partyName String?
  reference String
  date DateTime @db.Date
  amount Decimal @db.Decimal(15,2)
  accountId String
  postingEntryId String @unique
  reversalEntryId String? @unique
  reason String
  support String
  createdById String
  createdAt DateTime @default(now())
  allocations CreditAllocation[]
  refunds CreditRefund[]
  @@unique([workspaceId,kind,reference])
  @@index([workspaceId,kind,date])
}

model CreditAllocation {
  id String @id @default(cuid())
  creditId String
  credit CreditBalance @relation(fields:[creditId],references:[id],onDelete:Restrict)
  invoiceId String?
  invoice Invoice? @relation(fields:[invoiceId],references:[id],onDelete:Restrict)
  billId String?
  bill Bill? @relation(fields:[billId],references:[id],onDelete:Restrict)
  date DateTime @db.Date
  amount Decimal @db.Decimal(15,2)
  postingEntryId String? @unique
  reversalEntryId String? @unique
  reversedDate DateTime? @db.Date
  reason String?
  createdAt DateTime @default(now())
  @@index([creditId,date])
  @@index([invoiceId])
  @@index([billId])
}

model CreditRefund {
  id String @id @default(cuid())
  creditId String
  credit CreditBalance @relation(fields:[creditId],references:[id],onDelete:Restrict)
  date DateTime @db.Date
  amount Decimal @db.Decimal(15,2)
  postingEntryId String @unique
  reversalEntryId String? @unique
  reversedDate DateTime? @db.Date
  reason String
  @@index([creditId,date])
}

model FinanceAction {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Restrict)
  requestId String
  fingerprint String
  result Json
  createdAt DateTime @default(now())
  @@unique([workspaceId,requestId])
}

model RecurringRun {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  requestId String
  kind String
  cutoffDate DateTime @db.Date
  createdById String
  result Json
  createdAt DateTime @default(now())
  occurrences RecurringOccurrence[]
  @@unique([workspaceId, requestId])
}

model RecurringOccurrence {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  runId String
  run RecurringRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  sourceType String
  sourceId String
  scheduledDate DateTime @db.Date
  instanceId String
  createdAt DateTime @default(now())
  @@unique([workspaceId, sourceType, sourceId, scheduledDate])
  @@index([workspaceId, instanceId])
}

model AccountingPeriod {
  id          String @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  targetDate  DateTime @db.Date
  status      String @default("OPEN")
  createdById String
  closedById  String?
  closedAt    DateTime?
  proof       Json?
  createdAt   DateTime @default(now())
  reviews     PeriodAccountReview[]
  @@unique([workspaceId, startDate, endDate])
  @@index([workspaceId, status, endDate])
}

model PeriodAccountReview {
  id          String @id @default(cuid())
  periodId    String
  period      AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  accountId   String
  status      String @default("OPEN")
  ownerId     String
  dueDate     DateTime @db.Date
  support     String
  reason      String
  fingerprint String
  reviewedById String
  reviewedAt  DateTime @default(now())
  @@unique([periodId, accountId])
}

model AuditEvent {
  id          String @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actorId     String
  action      String
  entityId    String
  reason      String?
  data        Json
  createdAt   DateTime @default(now())
  @@index([workspaceId, createdAt])
  @@index([workspaceId, entityId])
}

model OpeningBalanceBatch {
  id          String      @id @default(cuid())
  workspaceId String      @unique
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  requestId   String
  fingerprint String
  asOfDate    DateTime    @db.Date
  currency    String      @db.VarChar(3)
  createdById String
  snapshot    Json
  createdAt   DateTime    @default(now())
  entries     JournalEntry[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, createdAt])
}

model AuthProvider {
  id                String           @id @default(cuid())
  userId            String
  provider          AuthProviderType
  providerAccountId String
  createdAt         DateTime         @default(now())
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model WorkspaceInvite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String?
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User?         @relation("InviteSender", fields: [invitedById], references: [id])
}

enum WorkspaceType {
  PERSONAL
  TEAM
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  APPROVER
  VIEWER
}

enum AuthProviderType {
  LOCAL
  GOOGLE
}
