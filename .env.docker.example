# Copy to .env and adjust if needed (optional – defaults work for local Docker)

# PostgreSQL (used by docker-compose for db + server)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=accounting

# API URL the browser will use (must be reachable from your machine)
# For local Docker: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Receipt scanning: GPT-3.5 parses OCR text (optional – OCR still works without it)
OPENAI_API_KEY=

# OCR: Google Cloud Vision API (required for receipt text extraction)
# Option 1 (easiest): API key from Credentials → API keys → Create key → restrict to Cloud Vision API → Show key
GCP_API_KEY=